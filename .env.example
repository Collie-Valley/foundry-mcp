# ── MCP de tableros de Foundry — SOLO configuración (sin credenciales) ────────────
# La autenticación NO va aquí: te la pide Claude Code (diálogo interactivo) la primera vez.
# Este archivo es opcional; sin él se usan los valores por defecto de abajo.

# API de Foundry (el MISMO backend que consume el frontend). Incluye el prefijo /api/v1.
# Sin esta variable se habla con el Foundry público: https://foundry.collie.digital/api/v1
# Descoméntala solo para apuntar a otro backend — el tuyo en local, o uno propio.
# FOUNDRY_API_BASE=http://localhost:8000/api/v1

# Segundos de espera a la API.
FOUNDRY_TIMEOUT=30

# ── Override opcional (solo automatización/CI, SIN diálogo) ────────────────────────
# Si defines esto, el MCP se autentica sin pedir nada. Para uso normal, déjalo comentado
# y deja que Claude Code te pida las credenciales.
# FOUNDRY_TOKEN=
# FOUNDRY_EMAIL=
# FOUNDRY_PASSWORD=
